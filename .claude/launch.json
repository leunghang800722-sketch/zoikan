{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "zoikan-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "zoikan-dev-smoke",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3301"
      ],
      "port": 3301
    },
    {
      "name": "zoikan-start",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3400"
      ],
      "port": 3400
    }
  ]
}
