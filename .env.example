# 複製做 .env（.env 已喺 .gitignore，唔會入 git）
# 本機 embedded-postgres（npm run db:start 之後用呢個）
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/zoikan"

# P1-WP2：session cookie 加密密碼，≥32 字符隨機字串。開發機可以照抄下面
# 呢串（唔係真密碼，淨係本機開發用）；生產部署一定要換一個獨立、唔入 git
# 嘅隨機值（例如 `openssl rand -base64 32`）。
SESSION_SECRET="dev-only-change-me-in-prod-0123456789abcdef"

# P1-WP2 seed 帳號密碼（假電話號碼 9000000x，PDPO：唔係真人）：
#   老闆   9000 0001  密碼 Passw0rd1
#   主管   9000 0002  密碼 Passw0rd2
#   會計   9000 0003  密碼 Passw0rd3
#   雞頭A  9000 0004  密碼 Broker0004（代號 K，掛 broker_id）
#   雞頭B  9000 0005  密碼 Broker0005（代號 W，掛 broker_id）
#   安員   9000 0006  密碼 Guard00006（測試用，安員自助 P4 先實作登入畫面）
# 真人帳號等老闆 D-P1-1 名單確認後先建立，呢度全部係假測試帳號。
# 正式環境：唔起 9000000x 假測試帳號（真人帳號見 README-P1「真人帳號」）
# SEED_SKIP_TEST_ACCOUNTS=1
