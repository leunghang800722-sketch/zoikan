# 複製做 .env（.env 已喺 .gitignore，唔會入 git）
# 本機 embedded-postgres（npm run db:start 之後用呢個）
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/zoikan"

# P1-WP2：session cookie 加密密碼，≥32 字符隨機字串。開發機可以照抄下面
# 呢串（唔係真密碼，淨係本機開發用）；生產部署一定要換一個獨立、唔入 git
# 嘅隨機值（例如 `openssl rand -base64 32`）。
SESSION_SECRET="dev-only-change-me-in-prod-0123456789abcdef"

# P1-WP2 seed 帳號密碼（假電話號碼 9000000x，PDPO：唔係真人）：
#   老闆   9000 0001  密碼 Passw0rd1
#   主管   9000 0002  密碼 Passw0rd2
#   會計   9000 0003  密碼 Passw0rd3
#   雞頭A  9000 0004  密碼 Broker0004（代號 K，掛 broker_id）
#   雞頭B  9000 0005  密碼 Broker0005（代號 W，掛 broker_id）
#   安員   9000 0006  密碼 Guard00006（測試用，安員自助 P4 先實作登入畫面）
# 真人帳號等老闆 D-P1-1 名單確認後先建立，呢度全部係假測試帳號。
# 正式環境：唔起 9000000x 假測試帳號（真人帳號見 README-P1「真人帳號」）
# SEED_SKIP_TEST_ACCOUNTS=1

# ---------------------------------------------------------------------------
# WP-AI1：側欄 AI 助手（唯讀，見 docs/ai-assistant.md）——以下全部假值，
# 開發機/CI 冇填都唔會影響其他功能；`助手` 呢個 module 冇呢啲 env 一樣
# seed 得到，淨係實際 call AI Hub/連 AI 唯讀 DB 嗰陣先用得著。
# ---------------------------------------------------------------------------
# WP-AI3：邊個 provider——anthropic/deepseek/fake，唔填就自動揀（有
# DEEPSEEK_API_KEY 就 deepseek，否則有 AI_HUB_API_KEY 就 anthropic，兩樣
# 都冇就助手 tab 唔顯示），見 src/lib/ai/config.ts resolveAiProvider()。
# AI_PROVIDER="deepseek"

# DeepSeek（OpenAI 格式，老闆 2026-09-12 揀用——見 src/lib/ai/providers/
# deepseek.ts）
DEEPSEEK_API_KEY="sk-deepseek-dev-fake-0123456789abcdef"
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# WP-OCR-CLAUDE §36：證件 OCR（/guards/new-from-docs）。讀 A＝Claude（Anthropic 官方 SDK）、讀 B＝DeepSeek，
# 兩邊一致先預填。真 key 只放正式站／本機 .env，唔好寫入 repo。
# CLAUDE_API_KEY=""
# GUARD_OCR_PROVIDER：claude+deepseek（預設）｜claude｜deepseek；冇 CLAUDE_API_KEY 自動退做 deepseek。
# GUARD_OCR_PROVIDER="claude+deepseek"
# 注意：只有 CLAUDE_API_KEY 冇 DEEPSEEK_API_KEY → 兩邊都 Claude，冇後備；建議兩個 key 都設。
# GUARD_OCR_CLAUDE_MODEL：預設 claude-opus-5-5
# GUARD_OCR_MODEL：DeepSeek 型號，預設 deepseek-flash

# Zeabur AI Hub（Anthropic 官方格式，Bearer token；DEEPSEEK_API_KEY 冇填
# 先會用呢個 fallback）
AI_HUB_BASE_URL="https://ai-hub.example.zeabur.app"
AI_HUB_API_KEY="sk-ai-hub-dev-fake-0123456789abcdef"
# AI_MODEL：兩個 provider 共用呢個 env，各自預設唔同——DeepSeek 冇填預設
# "deepseek-v4-pro"，Anthropic 冇填預設 "claude-opus-5"。
AI_MODEL="deepseek-v4-pro"
# AI 助手用嘅獨立唯讀 DB 連線（zoikan_ai_ro，見 npm run db:ensure-ai-role）
AI_DATABASE_URL="postgresql://zoikan_ai_ro:dev-ai-ro-pw-change-me@127.0.0.1:54329/zoikan"
AI_DB_PASSWORD="dev-ai-ro-pw-change-me"
# 每人每日問答上限（超過 429）
AI_DAILY_LIMIT=100

# 登入維持期限（可選）：閒置 N 日內有開過 app 就自動續期（預設 30，整數 1–90）；
# 由登入起計絕對上限（預設 90，整數，≥ idle 且 ≤180），過咗要重新打密碼。
# SESSION_IDLE_DAYS=30
# SESSION_ABSOLUTE_DAYS=90
