{
  "name": "zoi-kan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "tsx scripts/db/start.ts",
    "db:stop": "tsx scripts/db/stop.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:ensure-ai-role": "tsx scripts/db/ensure-ai-role.ts",
    "report:regen": "tsx scripts/report/index.ts && tsx scripts/report/diff.ts",
    "assignments:rollover": "tsx scripts/assignments/rollover.ts",
    "gate:export": "tsx scripts/report/roster-export-diff.ts --month 2026-07 && tsx scripts/report/roster-export-diff.ts --month 2026-07 --derived && tsx scripts/report/roster-export-newmonth-gate.ts",
    "gate:reports": "tsx scripts/gate/reports.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "iron-session": "^8.0.4",
    "next": "^15.5.25",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@prisma/client": "^6.9.0",
    "@tailwindcss/postcss": "^4",
    "@types/async-exit-hook": "^2.0.2",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "async-exit-hook": "2.0.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "exceljs": "^4.4.0",
    "prisma": "^6.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
