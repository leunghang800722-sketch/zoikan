// 在勤保安排更系統 — Prisma schema v1.1
// 依據：《在勤系統設計文件v1.0》§3、《P1-執行計劃.md》§3
// PDPO：呢個檔案本身唔含任何真名／工號／電話 —— 只有欄位定義。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum BrokerKind {
  broker // 外判雞頭（真名見 gitignored 嘅 data/mappings-private/brokers.csv，代號 K/W/G/D/T）
  internal_cash // 公司兵（Y，現金日薪直聘）
  internal_longterm // 長工（autopay 月薪）
  external // 客戶自己嘅人（Wilson Guard），唔入糧唔開單
  special // 散 Event／獨立雞頭費／個別雞頭 Event 呢類特殊結算單位
}

enum SettlementType {
  cash
  autopay
  salary // 個別雞頭：月薪＋Event 佣金
  none // external：客戶自己嘅人，唔適用
}

enum ActiveStatus {
  active
  inactive
}

enum SiteStatus {
  active
  paused
  ended
}

enum EmploymentType {
  cash_casual // 散現金安員
  longterm_autopay // 長工，autopay 月薪
  external // 客戶自己嘅人
  casual_event // 散 Event（例：HKU Y更 獨立雞頭費 5 人）
}

enum BillingModel {
  per_shift // 按更
  monthly_fixed // 月費（可能有 monthly_posts 崗數）
  admin_fee // 行政費
  special // 特殊（例如純登記、月結以外）
}

enum ProrataBasis {
  div_31 // 固定除 31（例：凱和山 27,000÷31）
  div_month_days // 除當月實際日數
}

enum BillingGroup {
  per_shift
  monthly_ic
}

enum RecordType {
  shift // 正更
  ot // 超時（掛靠 parent_shift_id）
  leave // 出勤狀態（RD/AL/SL/NL/SH）
}

// P1-WP3 第三輪規劃裁定（2026-09-12）：擴充至
// `tools/importer/mappings/status_codes.csv` 全部代號（含原始未歸一
// 字面，例：OFF/NPL）——原本淨係得 5 個「已歸一」值（RD/AL/SL/NL/SH），
// 原檔有出現過但同義嘅字面（OFF=RD、NPL=NL）會喺 P0 import 嗰陣直接
// 歸一，令 DB 冇存返原始字面，更表匯出對唔返原檔嗰粒代號。而家保留
// 埋原始字面做獨立 enum 值，seed 時（`scripts/seed/lib/
// leave-code-raw.ts`）逐條 leave 記錄由原檔 cell 讀返原始字面覆蓋，
// 冇讀到/唔識嘅字先跌返 wp2b 已歸一嘅值。
enum LeaveCode {
  RD
  OFF // = RD（status_codes.csv「歸一做 RD」），保留原字面
  AL
  SL
  NL
  NPL // = NL（status_codes.csv「歸一做 NL」），保留原字面
  SH
}

enum ShiftRecordStatus {
  draft // 雞頭已填
  pending_approval
  confirmed
  completed
  cancelled
}

enum SpecialItemKind {
  casual_event // 散 Event（HKU Y更 獨立雞頭費 94 更呢類）
  standalone_broker_fee // 獨立雞頭費
  individual_broker_event // 個別雞頭（billing_model=special_income 嗰類）自己嘅 Event 特殊收入項
  shuttle // 專車
  per_hour // 按鐘
  supplemental // 補單（龍譽／惠康）
  cross_month_adjustment // 跨月調整（例：扣上月一更／補上月漏計，見設計文件§3.2 payout_batches「支援跨月調整」）
  // P1-WP4（規劃裁定，2026-09-12）：長工雞頭費——老闆喺「在勤總表」手打
  // 嘅費用行金額（唔係一條可以由 shift_records 逐更計返嚟嘅公式，見
  // scripts/seed/lib/py/extract_referral_fees.py 頂註解），逐 (broker_id,
  // block) seed 做呢個 kind 嘅 special_item（cost=金額，siteId 有得配對
  // 就填、配對唔到就 null）。
  referral_fee
  other
}

enum PermissionAction {
  view
  create
  update
  void
  export
}

enum UserStatus {
  active
  inactive
}

enum PayoutBatchStatus {
  draft
  pending_approval
  approved
  paid
}

// WP-ROSTER-UPLOAD Phase A（老闆 2026-09-21/23 拍板，§15）：逐盤更表檔案
// 上載嘅生命週期。`confirmed` 留俾 Phase B（對數確認之後）用，Phase A
// 唔會寫呢個值。同盤同月新上載一律將舊版行改做 `superseded`（舊版留底，
// 唔刪）。
enum RosterUploadStatus {
  uploaded // 檔案已存底，解析未行完／未存 rows（理論上短暫狀態，解析係
  // 上載嗰刻同步做，正常唔會停留喺呢個狀態）
  parsed // 解析成功，rows 已存
  parse_failed // 解析拋錯（壞檔／完全冇 Date 表頭），rows 冇存，parse_error 有原因
  superseded // 同盤同月俾更新嘅版本取代，留底唔刪
  confirmed // Phase B 用：對數確認完成
  // WP-UPLOAD-VOID（老闆 2026-09-25 要求：正式站揀錯月份上載咗 8 月更表，
  // UI 冇刪除／撤銷）：會計/主管/老闆人手作廢一個上載記錄（唔 hard
  // delete，檔案 bytes 留底）——`confirmed`（已對數確認寫入 shift_
  // records）唔可以直接作廢，要先去對數頁處理。
  voided
}

// 逐格代號嘅種類——對應 tools/importer cell_codes.csv 嘅 kind，`pointer`
// 呢個 python 名改做 `marker`（同 P2 §15.3 用字一致：數碼港 CP5「數據
// 中心」指針格）。
enum RosterUploadCodeKind {
  shift // 正更（python 版 kind=work）
  leave // 假期代號（RD/AL/SL/NL/SH/OFF/NPL…）
  ot // OT<n> 超時
  marker // 指針格（例：數碼港 CP5「數據中心」），唔算一更
  unknown // 對唔到 cell_codes 對照表，人手覆核
}

// 逐行安員配對嘅結果——「唔准估」，配對唔到就 unmatched，唔會靜靜襲用第
// 一個近似結果。
enum RosterUploadGuardMatch {
  by_staff_no // staff_no_raw 正規化之後對到 guard_staff_numbers/guards.staff_no
  by_name_tel // name+tel 一齊啱先當啱
  by_name // 淨係憑姓名啱（風險較高，UI 要標）
  unmatched // 完全對唔到
  ambiguous // 對到多過一個候選，人手覆核
}

// ---------------------------------------------------------------------------
// brokers 雞頭
// ---------------------------------------------------------------------------
model Broker {
  id               String         @id @default(uuid())
  code             String         @unique // K/W/G/D/T/Y…
  name             String // 業務代號或真名——真名對照見 gitignored 嘅 data/mappings-private/brokers.csv，git 內預設用代號 K/W/G/D/T/Y
  kind             BrokerKind
  settlementType   SettlementType @map("settlement_type")
  bankInfo         Json?          @map("bank_info")
  requiresApproval Boolean        @default(false) @map("requires_approval")
  isInternal       Boolean        @default(false) @map("is_internal")
  aliases          String[]       @default([])
  status           ActiveStatus   @default(active)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  defaultForGuards        Guard[]                @relation("GuardDefaultBroker")
  rateCards               RateCard[]
  referralFeeRates        ReferralFeeRate[]
  settlementShiftRecords  ShiftRecord[]          @relation("ShiftRecordSettlementBroker")
  operationalShiftRecords ShiftRecord[]          @relation("ShiftRecordOperationalBroker")
  users                   User[]
  specialItems            SpecialItem[]
  siteAssignments         BrokerSiteAssignment[]
  quotas                  Quota[]
  rosterUploadRows        RosterUploadRow[]
  // WP-LTSHIFT：呢個雞頭介紹咗邊啲長工入職／擔保邊啲簽證長工——見
  // Guard.referralBrokerId／visaSponsoredByBrokerId。
  referredGuards          Guard[]                @relation("GuardReferralBroker")
  visaSponsoredGuards     Guard[]                @relation("GuardVisaSponsor")

  @@map("brokers")
}

// ---------------------------------------------------------------------------
// WP-LTSHIFT（老闆 2026-09-26）：長工崗位盤——邊個長工「駐」邊個盤，
// 用嚟判斷更表某一格應該歸結算單位 internal_longterm（B07，總表口徑
// 「(8) 長工」格）定係跟更表雞頭碼幫雞頭頂散更。見任務書 §2。
// 一個長工可以同時有幾個生效中嘅崗位盤（多盤兼顧），`effectiveTo=null`
// ＝現時生效。`source` 分三種來源，全部可追溯：
//   manual＝老闆／主管喺安員抽屜手動加，或者 guard-fix `set_longterm_post`
//           計劃套用（由 Postorder 上載解析嚟）；
//   july_backfill＝呢個 migration 由 7 月 `shift_records.settlement_
//           broker.kind='internal_longterm'` 反推嘅 (guard, site) 組合；
//   inferred＝對數/reconcile-all 嗰陣搵唔到任何崗位記錄，用該月更表
//           行占比 ≥50% 自動推算（保守預設，note 寫低比例，有 warning）。
// 「盤名」（site）唔係 PII，呢張表冇任何 PII 欄，安員抽屜「長工崗位盤」
// 呢個 sub-module 唔使額外 PII grant，跟「安員」module 一般 view/update
// 權限就夠。
// ---------------------------------------------------------------------------
enum GuardLongtermPostSource {
  manual
  july_backfill
  inferred
}

model GuardLongtermPost {
  id      String @id @default(uuid())
  guardId String @map("guard_id")
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Restrict)
  siteId  String @map("site_id")
  site    Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date

  source GuardLongtermPostSource @default(manual)
  note   String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  @@index([guardId])
  @@index([siteId])
  @@map("guard_longterm_posts")
}

// ---------------------------------------------------------------------------
// broker_site_assignments（P1-WP2 Opus 驗收 C1 新增）：邊個雞頭喺邊個盤、
// 邊個月有份——雞頭嘅「歸屬」白名單，唔准淨係靠「有冇更次記錄」判斷可見性
// /寫入權（嗰個係可以憑空開更、guard嫁接嘅漏洞）。quotas 表本身 P3 先做，
// 呢個表暫代做 P1 嘅歸屬判斷來源；P0 7 月真數據由
// scripts/seed/index.ts 嘅 seedBrokerSiteAssignments() 根據 shift_records
// 實際 settlement/operational broker × site × 月份反推生成。
// ---------------------------------------------------------------------------
model BrokerSiteAssignment {
  id       String   @id @default(uuid())
  brokerId String   @map("broker_id")
  broker   Broker   @relation(fields: [brokerId], references: [id])
  siteId   String   @map("site_id")
  site     Site     @relation(fields: [siteId], references: [id])
  month    DateTime @db.Date // 月份第一日

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@unique([brokerId, siteId, month])
  @@map("broker_site_assignments")
}

// ---------------------------------------------------------------------------
// referral_fee_rates 雞頭介紹費率（P3a：逐盤逐雞頭逐月可變）
// ---------------------------------------------------------------------------
model ReferralFeeRate {
  id          String   @id @default(uuid())
  brokerId    String   @map("broker_id")
  broker      Broker   @relation(fields: [brokerId], references: [id])
  siteId      String?  @map("site_id") // null = 該雞頭全盤預設費率；有 site_id 嘅行覆蓋預設
  site        Site?    @relation(fields: [siteId], references: [id])
  month       DateTime @db.Date // 月份第一日
  feePerShift Decimal  @map("fee_per_shift") @db.Decimal(12, 2)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  // P1-WP3（E）：跟其他主數據表一樣「只作廢冇刪除」（quotas/rate_cards
  // 同一 pattern）——新加落一份 migration，唔准改 init migration。
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  @@unique([brokerId, siteId, month])
  @@map("referral_fee_rates")
}

// ---------------------------------------------------------------------------
// quotas 配額（P1-WP3；設計文件§3.2、§4.1——主管派：呢個盤、呢個更別、
// 呢個月，畀呢個雞頭幾多更；軟性限制，超額唔擋，UI 黃警示）。
// ---------------------------------------------------------------------------
model Quota {
  id           String    @id @default(uuid())
  month        DateTime  @db.Date // 月份第一日
  siteId       String    @map("site_id")
  site         Site      @relation(fields: [siteId], references: [id])
  shiftTypeId  String    @map("shift_type_id")
  shiftType    ShiftType @relation(fields: [shiftTypeId], references: [id])
  brokerId     String    @map("broker_id")
  broker       Broker    @relation(fields: [brokerId], references: [id])
  targetShifts Int       @map("target_shifts")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  @@unique([month, siteId, shiftTypeId, brokerId])
  @@map("quotas")
}

// ---------------------------------------------------------------------------
// guards 安員
// ---------------------------------------------------------------------------
model Guard {
  id                   String         @id @default(uuid())
  // WP-STAFFNO（老闆 2026-09-19 拍板）：呢兩個舊欄而家改做**同步顯示值**
  // ——真正存底喺下面 `staffNumbers`（`guard_staff_numbers` 表，方案
  // B：員工編號獨立表，U／MP／MG／MW 並存）。`staffNo`＝該人現用 **U**
  // 號（冇 U 就 null）；`staffNoMw`＝現用 **MG**（冇就 MW）。任何員工編號
  // 增／改／轉舊號之後都由 `syncLegacyStaffNoColumns()`（`src/lib/
  // guards/staff-numbers.ts`）喺同一 transaction 內重算呢兩欄，唔准兩邊
  // 唔一致——更表編輯器／匯出／報表／`ai.guards` view／seed gate 全部
  // 照舊讀呢兩欄，唔使改。
  staffNo              String?        @unique @map("staff_no") // 同步值：現用 U 號，可為空
  staffNoMw            String?        @map("staff_no_mw") // 同步值：現用 MG（冇就 MW）
  nameZh               String         @map("name_zh")
  nameEn               String?        @map("name_en")
  tel                  String?
  defaultBrokerId      String?        @map("default_broker_id")
  defaultBroker        Broker?        @relation("GuardDefaultBroker", fields: [defaultBrokerId], references: [id])
  employmentType       EmploymentType @map("employment_type")
  monthlySalary        Decimal?       @map("monthly_salary") @db.Decimal(12, 2)
  siaPermitExpiry      DateTime?      @map("sia_permit_expiry") @db.Date
  poloSize             String?        @map("polo_size")
  mergedFrom           String[]       @default([]) @map("merged_from") // 身份合併留痕（舊 staff_no/id）
  // WP-GUARD-FIX（老闆 2026-09-25 要求）：「更表用名（別名）」——更表姓
  // 名格寫法可能同系統本名（`nameZh`）唔同（花名／簡寫／曾用名），
  // `matchGuard()`（src/lib/roster-upload/match.ts）配對次序加咗「別名＋
  // 電話」／「別名唯一」呢兩步，用呢個欄做候選。屬於「安員個人資料」
  // PII field group（見 src/lib/api/field-groups.ts GUARD_PII_FIELDS），
  // 雞頭 DTO（GUARD_BROKER_FIELDS，src/lib/broker-dto.ts）同 `ai.guards`
  // view（明列欄位，冇加呢個）一律唔包。
  nameAliases          String[]       @default([]) @map("name_aliases")
  // WP-STAFF-IMPORT B3：批量導入時未確認（review）嘅欄（例如 ["name_zh"]），覆核確認後移除。
  identityReviewFields String[]       @default([]) @map("identity_review_fields")
  status               ActiveStatus   @default(active)

  // WP-PII（老闆 2026-09-17 拍板）：保安員個人資料欄位——全部 nullable
  // （逐步補齊，唔逼舊記錄一次過填晒）。權限分兩組（`src/lib/rbac/
  // matrix.ts`）：「安員個人資料」管 hkid／dateOfBirth／address／
  // emergencyContact*／blacklistCheck*；「安員銀行資料」管 bank*；牌照／
  // 平安卡／入職離職日期跟現有「安員」module（主管出廠有，即「主管睇
  // 部分」）。`ai.guards` view（見 prisma/migrations/…wp_ai1_readonly_
  // schema）明列欄位，呢 16 個新欄一律唔加入去——AI 助手結構上讀唔到
  // （唔淨係 field-scrub 呢層 defense-in-depth，係 DB view 本身冇呢啲欄）。
  // 注意：`guards_hkid_key`（partial unique, hkid IS NOT NULL）由 migration／scripts/db/ensure-identity-indexes.ts
  // 管，Prisma schema 表達唔到——`migrate dev` 嘅 drift 偵測可能想 DROP 佢，唔好接受。
  hkid                 String?   @map("hkid") // 身份證號碼——列表遮罩顯示，詳情/編輯有「安員個人資料:view」先見全號
  dateOfBirth          DateTime? @map("date_of_birth") @db.Date
  address              String?   @map("address")
  emergencyContactName String?   @map("emergency_contact_name")
  emergencyContactTel  String?   @map("emergency_contact_tel")
  siaPermitNo          String?   @map("sia_permit_no")
  // WP-STAFFNO（老闆 2026-09-19 拍板）：`siaPermitType` 改做**衍生顯示值**
  // （A／B／A+B，見 `deriveSiaPermitExpiry()`），唔再直接接受 API 寫入——
  // 真正存底嘅係下面 siaPermitAExpiry／siaPermitBExpiry 兩個獨立到期日。
  siaPermitType        String?   @map("sia_permit_type") // 衍生值：A／B／A+B（PATCH 甲/乙/出生日期時自動重算，唔准直接寫）
  // WP-STAFFNO：甲類／乙類到期日分開存（乙類過 70 歲失效，淨返甲類仍要
  // 存底——兩個都要存，唔係二揀一）。`siaPermitExpiry`（下面）保留做
  // **衍生值**＝兩個入面「仍然有效而最早到期」嗰個，`ai.guards` view／
  // 90 日篩選繼續讀呢個舊欄，唔使改。
  siaPermitAExpiry     DateTime? @map("sia_permit_a_expiry") @db.Date
  siaPermitBExpiry     DateTime? @map("sia_permit_b_expiry") @db.Date
  safetyCardNo         String?   @map("safety_card_no") // 平安卡號碼
  safetyCardExpiry     DateTime? @map("safety_card_expiry") @db.Date
  // WP-MISC（老闆 2026-09-20 拍板）：QAS（基本保安訓練證書）日期——跟
  // 「安員」module（同牌照／平安卡欄一樣嘅讀寫規則）。`qasIssueDate`＝
  // 完成日期（UI 標籤「QAS 完成日期」），`qasExpiryDate`＝到期日（如有，
  // UI 標籤「QAS 到期日（如有）」）——來源檔個欄過去日子＝完成、未來
  // 日子＝到期，混雜咗，分開兩欄先唔會入錯。`qasExpiryDate` 納入「90 日
  // 內到期／已過期」高亮同列表最近到期 pill（同 safetyCardExpiry 一樣，
  // 見 earlierExpiry() / licenceExpiryPill()）。
  qasIssueDate         DateTime? @map("qas_issue_date") @db.Date
  qasExpiryDate        DateTime? @map("qas_expiry_date") @db.Date
  hireDate             DateTime? @map("hire_date") @db.Date
  leaveDate            DateTime? @map("leave_date") @db.Date
  // WP-LTPAY（老闆 2026-09-26，§14 規則 9）：試用期長度（月）——Maxwell
  // 「Probation Period (Months)」欄，null／0＝冇試用期（即刻生效）。長工
  // 年假 entitlement／離職補年假要用（試用期入面離職＝entitlement 0）。
  // 呢個係安員層面嘅快照顯示值；權威仍然係 `GuardLongtermContract.
  // probationMonths`（逐段合約可以唔同），呢欄方便更表/安員頁唔使 join。
  probationMonths      Int?      @map("probation_months")
  bankName             String?   @map("bank_name")
  bankAccountNo        String?   @map("bank_account_no")
  bankPayeeName        String?   @map("bank_payee_name")
  // WP-BOSS5 §25.4（老闆 2026-09-28 決定 6）：BOCHK Payroll Editor 明細
  // 要「員工賬戶銀行編號」——3 位 HKICL 清算銀行編號（`src/lib/longterm-
  // payroll/hkicl-bank-codes.ts` 俾建議下拉，逐個核實過，唔會憑
  // `bankName` 自動填）。同 `bankName`/`bankAccountNo`/`bankPayeeName`
  // 一組 PII field group「安員銀行資料」。
  bankCode             String?   @map("bank_code")
  blacklistCheckResult String?   @map("blacklist_check_result") // clear／flagged／pending，zod 白名單管
  blacklistCheckDate   DateTime? @map("blacklist_check_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  // WP-LTSHIFT（老闆 2026-09-26）：長工介紹雞頭——邊個雞頭介紹呢個長工
  // 入職，用嚟自動計介紹費（`src/lib/reports/referral-fee.ts`）。抽屜
  // 可揀（見 `set_referral` guard-fix plan 類）。nullable：唔係全部長工
  // 都有記錄到係邊個雞頭介紹。
  referralBrokerId        String? @map("referral_broker_id")
  referralBroker          Broker? @relation("GuardReferralBroker", fields: [referralBrokerId], references: [id])
  // WP-LTSHIFT：簽證形式長工——呢個長工嘅簽證由邊個雞頭擔保。有值＝
  // 呢個人**永遠**當該雞頭散更結算（唔理崗位盤），跟 §14 任務書規則。
  visaSponsoredByBrokerId String? @map("visa_sponsored_by_broker_id")
  visaSponsoredByBroker   Broker? @relation("GuardVisaSponsor", fields: [visaSponsoredByBrokerId], references: [id])

  rateCards             RateCard[]
  shiftRecords          ShiftRecord[]
  users                 User[]
  staffNumbers          GuardStaffNumber[]
  longtermPosts         GuardLongtermPost[]
  matchOverrides        GuardMatchOverride[]
  // WP-MULTI（老闆 2026-09-19 拍板「全部資料都要保留，唔好揀一個」）：
  // 電話／緊急聯絡人／地址呢三樣而家可以「有幾多個記幾多個」，方案跟
  // WP-STAFFNO 一致（獨立子表＋`guards.tel`／`address`／
  // `emergency_contact_*` 呢幾個舊欄改做**同步顯示值**，見
  // src/lib/guards/contacts.ts syncLegacyGuardContactColumns()）。
  phones                GuardPhone[]
  emergencyContacts     GuardEmergencyContact[]
  addresses             GuardAddress[]
  rosterUploadRows      RosterUploadRow[]
  // WP-LTPAY（§14 規則 9）：長工月薪糧——合約／假期結餘／人手輸入項／
  // 逐人結算行。
  longtermContracts     GuardLongtermContract[]
  leaveBalances         GuardLeaveBalance[]
  avgWages              GuardAvgWage[]
  longtermPayrollInputs LongtermPayrollInput[]
  longtermPayrollLines  LongtermPayrollLine[]

  @@map("guards")
}

// WP-MULTI（老闆 2026-09-19 拍板）：保安員可以有幾多個電話就記幾多個
// （唔再淨係 `guards.tel` 一個），跟員工編號（`GuardStaffNumber`）一樣嘅
// 「獨立子表＋legacy 欄同步」pattern。`label` 刻意用 String（唔係
// Prisma enum）——「本人／屋企／WhatsApp／其他自由文字」，app 層唔限制
// 死一個白名單。`UNIQUE(guard_id, tel)` 防止同一個人重複記同一個電話；
// partial unique index（見 migration.sql，schema 表達唔到 WHERE 子句）
// 保證同一個 guard 最多一行 `is_primary=true`。
model GuardPhone {
  id      String @id @default(uuid())
  guardId String @map("guard_id")
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Restrict)

  tel       String
  label     String? // 本人／屋企／WhatsApp／其他自由文字，可空
  isPrimary Boolean @default(false) @map("is_primary")
  // migration:tel（由 guards.tel backfill 嚟）／manual（API 手動加）等，
  // 同 GuardStaffNumber.source 一致做法。
  source    String?
  note      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  // `guard_phones_tel_key`（tel 全表唯一）由 migration／scripts/db/ensure-identity-indexes.ts 管（有重複就唔建），
  // Prisma schema 唔宣告——`migrate dev` drift 偵測可能想 DROP 佢，唔好接受。
  @@unique([guardId, tel])
  @@index([guardId])
  @@map("guard_phones")
}

// WP-STAFF-IMPORT B1：身份證／電話重複記錄（只存 sha256，唔存明文）。
// 唯一性本身靠 migration 建嘅 partial unique index（guards_hkid_key、
// guard_phones_tel_key，Prisma schema 表達唔到 partial index，同
// guard_phones_guard_id_primary_key 一樣只喺 migration）；有重複就唔建 index。
model GuardIdentityConflict {
  id         String    @id @default(uuid())
  kind       String // dup_hkid／dup_tel（淨存涉及嘅 guard id，唔存值／hash——可窮舉）
  guardIds   String[]  @default([]) @map("guard_ids")
  createdAt  DateTime  @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  // 唯一性：migration 用 id = md5(kind || 排序後 guard id) 決定性生成，PK 即唯一。
  @@map("guard_identity_conflicts")
}

// WP-AI-OPS §28.4：導入後對話式分診。session＝一次批量導入（source_ref＝導入包 sha256，冪等）；
// owner_user_id＝上載者（老闆可轉交）。questions 由規則產生（唔經外部 AI），evidence_json 含安員 PII
// （同 guards 表同級；API 層按「安員個人資料」權限遮罩）。新表放 public，**唔入 ai schema**，
// ai.audit_log 排除 triage_* 兩個 table_name。
model TriageSession {
  id          String    @id @default(uuid())
  sourceType  String    @map("source_type") // guard_import｜roster_upload（預留）
  sourceRef   String    @map("source_ref") // guard_import＝導入包 sha256
  ownerUserId String    @map("owner_user_id")
  owner       User      @relation("TriageSessionOwner", fields: [ownerUserId], references: [id])
  createdBy   String    @map("created_by")
  status      String    @default("open") // open｜done
  statsJson   Json      @default("{}") @map("stats_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  /// HMAC key 版本指紋（SESSION_SECRET 輪換偵測：同而家唔同＝舊 key，open 題一律當 superseded）
  keyFp         String?   @map("key_fp")
  lastAppliedAt DateTime? @map("last_applied_at")

  questions TriageQuestion[]

  @@unique([sourceType, sourceRef])
  @@index([ownerUserId, status])
  @@map("triage_sessions")
}

model TriageQuestion {
  id        String        @id @default(uuid())
  sessionId String        @map("session_id")
  session   TriageSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  /// 題目建立時嘅人 key（serverPersonKey；bank_identity_unknown＝戶口 ref）同鎖定嘅目標 guard（ext／bank 題）
  personKey     String? @map("person_key")
  targetGuardId String? @map("target_guard_id")
  kind     String // name_not_confirmed｜hkid_not_confirmed｜name_only_candidate｜…（見 src/lib/triage/types.ts）
  groupKey String @map("group_key") // 同一 session 內唯一（導入人 key）——保證冪等、已解決唔再出
  sort     Int    @default(0)
  title    String

  evidenceJson Json  @default("{}") @map("evidence_json") // 人嘅快照（含 PII）＋理由碼＋候選 guard id
  optionsJson  Json  @default("[]") @map("options_json")
  impactJson   Json? @map("impact_json") // 最近一次預覽嘅影響摘要（唔含 hash）

  status          String    @default("open") // open｜answered｜skipped｜superseded（較新同 group_key＋kind 題出現後，舊 open 題）
  answerJson      Json?     @map("answer_json")
  answeredBy      String?   @map("answered_by")
  answeredAt      DateTime? @map("answered_at")
  applyResultJson Json?     @map("apply_result_json")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sessionId, groupKey])
  @@index([sessionId, status, sort])
  @@index([personKey])
  @@index([targetGuardId])
  @@index([groupKey])
  @@map("triage_questions")
}

/// 每次自動 apply 導入包，對包內每個人記一行：「最近一次包含呢個人嘅包」先可以答佢嘅題。
model TriagePersonApply {
  id        Int      @id @default(autoincrement())
  personKey String   @map("person_key")
  guardId   String?  @map("guard_id")
  sourceRef String   @map("source_ref")
  isV3      Boolean  @default(false) @map("is_v3")
  appliedAt DateTime @default(now()) @map("applied_at")

  @@unique([personKey, sourceRef])
  @@index([guardId])
  @@index([personKey, appliedAt])
  @@map("triage_person_applies")
}

// WP-MULTI：保安員可以有幾多個緊急聯絡人就記幾多個。`name`／`tel` 唔可以
// 同時空（見 migration.sql CHECK constraint）；`sortOrder` 俾用戶自己
// 排順序（`guards.emergency_contact_name`／`_tel` 呢兩個舊欄同步值＝
// sort_order 最細嗰個，見 src/lib/guards/contacts.ts）。
model GuardEmergencyContact {
  id      String @id @default(uuid())
  guardId String @map("guard_id")
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Restrict)

  name         String?
  tel          String?
  relationship String?
  sortOrder    Int     @default(0) @map("sort_order")
  source       String?
  note         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([guardId])
  @@map("guard_emergency_contacts")
}

// WP-MULTI（規劃師延伸，同一原則）：地址可以有幾個，一個主要（同
// GuardPhone 一致嘅 partial unique 手法）。
model GuardAddress {
  id      String @id @default(uuid())
  guardId String @map("guard_id")
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Restrict)

  address   String
  isPrimary Boolean @default(false) @map("is_primary")
  source    String?
  note      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([guardId])
  @@map("guard_addresses")
}

// ---------------------------------------------------------------------------
// WP-STAFFNO（老闆 2026-09-19 拍板）：員工編號獨立表（方案 B）——員工編號
// 並存唔取代：U＝去 Wilson 盤做散工必須有；MP＝去第二間公司嘅盤做散工
// 用；MG＝轉咗長工；MW 意思未確認（老闆仲未答）。同一人可以同時有
// U／MP／MG；同一種入面亦可能有多個號（臨時號→正式號、離職再入職攞
// 新號）——舊號存底但摺埋（status=former）。`scheme` 刻意用 String（大寫
// 英文字母 1–4 位，zod regex 管，唔用 Prisma enum）——已知 U／MP／MG／MW，
// 但邊個盤顯示邊種號、轉長工後 U／MP 係咪繼續有效呢啲老闆都仲未答，等
// 將來加新種類唔使 migration。
model GuardStaffNumber {
  id      String @id @default(uuid())
  guardId String @map("guard_id")
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Restrict)

  scheme String // U/MP/MG/MW/…，app 層 regex 驗證（^[A-Z]{1,4}$）
  // 全表 unique——同一個工號唔可以掛喺兩個唔同 guard（POST 撞號 409）。
  number String                 @unique
  status GuardStaffNumberStatus @default(current)

  validFrom DateTime? @map("valid_from") @db.Date
  validTo   DateTime? @map("valid_to") @db.Date
  note      String?
  // migration:staff_no／migration:staff_no_mw（搬遷嚟）／manual（API 手動
  // 加）／import:u-team 等——邊度嚟嘅呢一行。
  source    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  // 同一個 guard 同一個 scheme 最多一行 current——用 partial unique index
  // 做（Prisma schema 冇 WHERE 子句表達能力，見 migration.sql 手加嘅
  // `CREATE UNIQUE INDEX ... WHERE status = 'current'`，呢度淨係留返
  // 一個普通 index 幫查詢，唔係約束本身）。
  @@index([guardId, scheme])
  @@map("guard_staff_numbers")
}

enum GuardStaffNumberStatus {
  current
  former
}

// ---------------------------------------------------------------------------
// sites 盤
// ---------------------------------------------------------------------------
model Site {
  id                  String        @id @default(uuid())
  canonicalName       String        @unique @map("canonical_name")
  aliases             String[]      @default([])
  clientName          String        @map("client_name")
  clientGroup         String?       @map("client_group")
  parentSiteId        String?       @map("parent_site_id")
  parent              Site?         @relation("SiteParent", fields: [parentSiteId], references: [id])
  children            Site[]        @relation("SiteParent")
  billingModel        BillingModel  @map("billing_model")
  monthlyFee          Decimal?      @map("monthly_fee") @db.Decimal(12, 2)
  monthlyPosts        Int?          @map("monthly_posts") // 每崗月費 × 崗數
  prorataBasis        ProrataBasis? @map("prorata_basis")
  inScope             Boolean       @default(true) @map("in_scope")
  /**
   * 月結「以外」：收入唔入月結總表主表（例如客戶另有合約嘅盤）；seed 由 data/mappings-private/report-overrides.json 嘅客戶名填，之後由盤管理頁改
   */
  outsideMonthlyClose Boolean       @default(false) @map("outside_monthly_close")
  // WP-MISC（老闆 2026-09-20 拍板，LINK：TKO Gateway 厚A/B/C）：呢批盤嘅
  // 保安員由客戶（Wilson）直接出糧，我哋淨係收每月服務費——唔逐更計
  // 客價／工資，唔使價目卡。true 嘅盤：(1) computeUnpricedSummary()／
  // isUnpricedShift()／isClientUnpricedShift() 唔算未定价；(2) 更表
  // batch save／reprice 唔寫 guard_wage/broker_fee/client_rate snapshot
  // （已有值唔清，保守）；(3) 更表編輯器頂部 Notice；(4) 盤管理頁可切換
  // （跟「盤」module update 權限）；(5) 唔改 gross-margin 服務費收入點計
  // （老闆話維持現狀）。見 src/lib/pricing/unpriced.ts、resolve-rate.ts。
  guardsPaidByClient  Boolean       @default(false) @map("guards_paid_by_client")
  status              SiteStatus    @default(active)
  // P1-WP3：更表版面模板（`RosterLayoutTemplate`，見
  // src/lib/roster-layout-template.ts）——由 seed 時由 data/ 讀出反推
  // 寫入（scripts/seed/lib/roster-layout.ts），匯出（src/lib/
  // roster-export.ts）用嚟出到原檔一致嘅 block 分組／橫額／表頭裝飾字。
  // null＝未有模板，匯出跌返用generic嘅「一個shift_type一個block」邏輯。
  rosterLayout        Json?         @map("roster_layout")
  // WP-UPLOAD-AUTOFIX（老闆 2026-09-25 要求：更表上載完全自動）：更表檔名
  // 入面穩定出現嘅識別字（例如「CTB 6907」）——上載時檔名 stem 含任一鍵
  // （NFKC、唔分大小寫、字詞邊界——鍵「615」唔中「9615」；最長鍵贏）就直接用
  // 呢個盤，優先過檔內盤名對照。用嚟解決「檔內盤名
  // 格寫錯／寫咗個共用字眼（同另一個盤主檔撞名）」呢類冇得靠內容分辨嘅
  // 情況（「CTB 6907」檔盤名格寫「城巴車廠」但實際係「創富廠IC」就係呢種
  // 例子）。見 src/lib/roster-upload/match.ts `matchSiteByFileName()`。
  rosterFileKeys      String[]      @default([]) @map("roster_file_keys")
  // WP-LTSHIFT（老闆 2026-09-26，§6）：呢個盤自己 0 條 shift_records，但
  // 同一「業務」實質活動記喺另一個盤（例：「數碼港 CP5 IC」純月費構造
  // 盤，實際更次記喺「數碼港 CP5」）——`monthly-close.ts` 反假營業額閘
  // （`hasAnyRecordThisMonth`）查「自己或 proxy 盤有記錄」，先至唔會將
  // 呢個盤當「完全冇活動」自動隱藏。刻意唔用 client_name/canonical_name
  // 前綴呢類字串猜測（規劃階段否決咗），淨係呢個顯式 FK，一盤一 proxy。
  activityProxySiteId String?       @map("activity_proxy_site_id")
  activityProxySite   Site?         @relation("SiteActivityProxy", fields: [activityProxySiteId], references: [id])
  activityProxyFor    Site[]        @relation("SiteActivityProxy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  shiftTypes               ShiftType[]
  rateCards                RateCard[]
  shiftRecords             ShiftRecord[]
  dailyRequirements        DailyRequirement[]
  specialItems             SpecialItem[]
  referralFeeRates         ReferralFeeRate[]
  brokerAssignments        BrokerSiteAssignment[]
  quotas                   Quota[]
  rosterUploads            RosterUpload[]
  // Phase B-0：一檔多子盤（城巴車廠／CP5）逐格「解析後實際盤」反向關聯
  // ——`RosterUploadRow.resolvedSiteId`，見嗰個 model 註解。
  resolvedRosterUploadRows RosterUploadRow[]
  longtermPosts            GuardLongtermPost[]
  // WP-LTPAY：長工合約 `postSiteId`（可 null）反向關聯。
  longtermContracts        GuardLongtermContract[]

  @@map("sites")
}

// ---------------------------------------------------------------------------
// shift_types 更別
// ---------------------------------------------------------------------------
model ShiftType {
  id                String       @id @default(uuid())
  siteId            String       @map("site_id")
  site              Site         @relation(fields: [siteId], references: [id])
  code              String // N/C/C1/A/B/IC/SIC/OT1/Event…
  label             String?
  startTime         DateTime?    @map("start_time") @db.Time
  endTime           DateTime?    @map("end_time") @db.Time
  hours             Decimal?     @db.Decimal(5, 2)
  headcountRequired Int?         @map("headcount_required")
  billingGroup      BillingGroup @default(per_shift) @map("billing_group")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  // WP2：呢個表冇現成「終態 enum」可以借嚟表達「作廢」，冇刪除規則要另加
  // voided_at/voided_by（原因留喺 audit_log.after，唔喺度重複存）
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  rateCards         RateCard[]
  shiftRecords      ShiftRecord[]
  dailyRequirements DailyRequirement[]
  quotas            Quota[]
  rosterUploadRows  RosterUploadRow[]

  // 規劃 session 裁定（2026-09-11）：DB 層強制 (site_id, code, start_time)
  // 唯一——master-roster-only 合成更別（例：國泰城 S038）seed 時逐個 post
  // 用 `MR-<label>-<n>` 做 code 保證唔撞（見 scripts/seed/index.ts）。
  @@unique([siteId, code, startTime])
  @@map("shift_types")
}

// ---------------------------------------------------------------------------
// rate_cards 價目（帶生效日期）
// ---------------------------------------------------------------------------
model RateCard {
  id            String        @id @default(uuid())
  siteId        String        @map("site_id")
  site          Site          @relation(fields: [siteId], references: [id])
  shiftTypeId   String?       @map("shift_type_id")
  shiftType     ShiftType?    @relation(fields: [shiftTypeId], references: [id])
  brokerId      String?       @map("broker_id") // null = 通用；指定 = 雞頭專屬價
  broker        Broker?       @relation(fields: [brokerId], references: [id])
  guardId       String?       @map("guard_id") // null = 通用；指定 = 人專屬價（長工日均）
  guard         Guard?        @relation(fields: [guardId], references: [id])
  clientRate    Decimal?      @map("client_rate") @db.Decimal(12, 2)
  guardWage     Decimal?      @map("guard_wage") @db.Decimal(12, 2)
  brokerFee     Decimal?      @map("broker_fee") @db.Decimal(12, 2)
  payoutRate    Decimal?      @map("payout_rate") @db.Decimal(12, 2) // = guardWage + brokerFee
  billingModel  BillingModel? @map("billing_model") // 呢張價卡本身嘅收費模式（可覆蓋 site 預設；site 級「flat」卡 = shiftType/broker/guard 三個 FK 皆空）
  effectiveFrom DateTime      @map("effective_from") @db.Date
  effectiveTo   DateTime?     @map("effective_to") @db.Date
  source        String?
  evidence      String?
  confidence    String?
  status        String?
  note          String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  // WP2 void（注意：`status` 欄已經俾 P0 import 用嚟存 confirmed/tentative
  // 呢類 provenance 狀態，唔可以借用嚟做「作廢」，所以加獨立欄）
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  @@map("rate_cards")
}

// ---------------------------------------------------------------------------
// shift_records 更次記錄（核心事實表）
// ---------------------------------------------------------------------------
model ShiftRecord {
  id          String    @id @default(uuid())
  workDate    DateTime  @map("work_date") @db.Date
  siteId      String    @map("site_id")
  site        Site      @relation(fields: [siteId], references: [id])
  shiftTypeId String    @map("shift_type_id")
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id])
  guardId     String    @map("guard_id")
  guard       Guard     @relation(fields: [guardId], references: [id])

  settlementBrokerId  String? @map("settlement_broker_id") // 邊個出糧
  settlementBroker    Broker? @relation("ShiftRecordSettlementBroker", fields: [settlementBrokerId], references: [id])
  operationalBrokerId String? @map("operational_broker_id") // 總表成本桶
  operationalBroker   Broker? @relation("ShiftRecordOperationalBroker", fields: [operationalBrokerId], references: [id])

  referralFeeSnapshot Decimal? @map("referral_fee_snapshot") @db.Decimal(12, 2)
  rescueRate          Decimal? @map("rescue_rate") @db.Decimal(12, 2) // 救更價覆寫

  recordType    RecordType    @default(shift) @map("record_type")
  leaveCode     LeaveCode?    @map("leave_code")
  otHours       Decimal?      @map("ot_hours") @db.Decimal(5, 2)
  parentShiftId String?       @map("parent_shift_id")
  parentShift   ShiftRecord?  @relation("ShiftRecordParent", fields: [parentShiftId], references: [id])
  childShifts   ShiftRecord[] @relation("ShiftRecordParent")

  locationTag    String? @map("location_tag") // 上村／摩星嶺
  isExternal     Boolean @default(false) @map("is_external")
  billed         Boolean @default(false)
  paid           Boolean @default(false)
  // 7 月紙本糧單「頁」嘅追溯標記（例：K-1331／K-LINK／公司兵-2／W…，真名見
  // gitignored 嘅 data/mappings-private/brokers.csv）。
  // DB 時代報表用 broker 粒度就夠，呢個欄淨係做歷史頁面追溯 + 糧明細對數
  // gate（見 scripts/report/payroll.ts、data/2026-07/transcribed/payroll-pages.csv）
  settlementPage String? @map("settlement_page")

  clientRateSnapshot Decimal? @map("client_rate_snapshot") @db.Decimal(12, 2)
  guardWageSnapshot  Decimal? @map("guard_wage_snapshot") @db.Decimal(12, 2)
  brokerFeeSnapshot  Decimal? @map("broker_fee_snapshot") @db.Decimal(12, 2)

  source     String?
  provenance Json?
  status     ShiftRecordStatus @default(confirmed)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@unique([guardId, workDate, shiftTypeId])
  @@index([siteId, workDate])
  @@index([workDate])
  @@map("shift_records")
}

// ---------------------------------------------------------------------------
// WP-ROSTER-UPLOAD Phase A（§15）：逐盤更表檔案上載——會計／主管／老闆
// 每月上載嘅、每個盤自己嘅更表檔案（xlsx），係計糧嘅 authoritative
// source（規則 11）。Phase A 淨係存＋解析＋顯示，**唔寫入
// shift_records**（對數＋寫入係 Phase B）。
//
// 檔案 bytes 存喺 DB（`file_bytes bytea`）——雞頭永遠冇「更表上載」
// module 嘅任何 grant（硬性 deny），連呢張表嘅 view 都攞唔到，file_bytes
// 更加冇任何 API 會回俾佢；AI 助手：`ai.*` schema 完全冇 `ai.roster_
// uploads`／`ai.roster_upload_rows` view（結構性隔離，見 migration
// `20260923000000_wp_roster_upload_a`），`ai.audit_log` 一齊 WHERE 排除
// 呢兩個 table_name（同 WP-MULTI 一致做法）。
// ---------------------------------------------------------------------------
model RosterUpload {
  id             String             @id @default(uuid())
  month          DateTime           @db.Date // 月份第一日
  siteId         String?            @map("site_id") // nullable——上載時盤名對唔到（site_raw
  // 喺 sites.canonical_name/aliases 搵唔到）可以先存底，之後 PATCH
  // 人手指定
  site           Site?              @relation(fields: [siteId], references: [id])
  siteNameRaw    String             @map("site_name_raw") // 更表檔案自己讀出嚟嘅盤名（A2/C2/A1），未必對得上 sites.canonical_name
  uploaderUserId String             @map("uploader_user_id")
  uploader       User               @relation(fields: [uploaderUserId], references: [id])
  uploadedAt     DateTime           @default(now()) @map("uploaded_at")
  fileName       String             @map("file_name")
  fileSha256     String             @map("file_sha256")
  fileBytes      Bytes              @map("file_bytes")
  fileSize       Int                @map("file_size")
  // 同盤同月遞增——siteId 未定（null）嗰陣用 siteNameRaw 分組計版本（見
  // src/lib/roster-upload/service.ts resolveNextVersion()）。
  version        Int                @default(1)
  status         RosterUploadStatus @default(uploaded)
  parseSummary   Json?              @map("parse_summary") // {shift_count, date_range, code_breakdown, unmatched_count, warnings…}
  parseError     String?            @map("parse_error")
  layoutKey      String?            @map("layout_key") // 自動偵測用咗邊套 layout 規則（standard/digital_port/citybus + 變體 flags）

  // WP-UPLOAD-VOID：人手作廢（唔 hard delete，file_bytes／rows／
  // reconcile_decisions 全部留底）。`voidedBy` 同呢個 codebase 其他
  // voidedBy 一致做法——plain user id string，唔起 FK relation。
  voidedAt   DateTime? @map("voided_at")
  voidedBy   String?   @map("voided_by")
  voidReason String?   @map("void_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  rows               RosterUploadRow[]
  // Phase B-1（§14.1／§15.3 分期）：呢個上載逐項對數決定（keep_system／
  // exception 留痕，見 RosterReconcileDecision 大註解）。
  reconcileDecisions RosterReconcileDecision[]

  @@index([month, siteId])
  @@map("roster_uploads")
}

model RosterUploadRow {
  id       String       @id @default(uuid())
  uploadId String       @map("upload_id")
  upload   RosterUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  rowIndex Int          @map("row_index") // 原檔行號（1-based，openpyxl/exceljs row number），追溯用

  subSiteName        String?              @map("sub_site_name") // 城巴車廠等一檔多子盤嘅子盤名（citybus layout 先有值）
  workDate           DateTime             @map("work_date") @db.Date
  rawCode            String               @map("raw_code") // 格仔原始代號（未歸一，例：OFF/NPL 保留原字面）
  codeKind           RosterUploadCodeKind @map("code_kind")
  shiftTypeId        String?              @map("shift_type_id") // 對唔到 shift_types 就 null（唔准估），warnings 記低
  shiftType          ShiftType?           @relation(fields: [shiftTypeId], references: [id])
  // Phase B-0（§15.3 第 3 項，一檔多子盤：城巴車廠 9 個子盤／CP5 夾數據
  // 中心）：呢行「語意上」實際屬邊個盤——上載掛嘅盤（`roster_uploads.
  // site_id`）有子盤（`sites.parent_site_id`）而且 `sub_site_name` 對到
  // 某個子盤，就係嗰個子盤；冇子盤嘅上載（絕大多數）就同上載本身嘅
  // site_id 一致；有子盤但 sub_site_name 對唔到就 null（唔准估，見
  // warnings）。更別配對（`shift_type_id`）跟呢個欄嘅盤範圍搵，唔跟
  // 上載本身嘅 site_id。
  resolvedSiteId     String?              @map("resolved_site_id")
  resolvedSite       Site?                @relation(fields: [resolvedSiteId], references: [id])
  // WP-GUARD-FIX 驗收（Opus 5.5）：`resolved_site_id` 係對數頁人手「批量
  // 指定子盤／全部歸母盤確認」揀嘅——`reparseRosterUpload()` 重建 rows
  // 嗰陣要保留呢個決定（唔俾三層推斷覆蓋），見 migration
  // 20260925130000_wp_guard_fix_resolved_site_manual。
  resolvedSiteManual Boolean              @default(false) @map("resolved_site_manual")

  staffNoRaw    String? @map("staff_no_raw")
  nameRaw       String? @map("name_raw")
  telRaw        String? @map("tel_raw")
  rankRaw       String? @map("rank_raw")
  timeRaw       String? @map("time_raw")
  brokerCodeRaw String? @map("broker_code_raw") // A 欄雞頭碼原文（可冇）

  guardId    String?                @map("guard_id") // 配對結果
  guard      Guard?                 @relation(fields: [guardId], references: [id])
  guardMatch RosterUploadGuardMatch @default(unmatched) @map("guard_match")
  // WP-STAFF-IMPORT B2：逐格配對依據（staff_no／tel／name_tel／name_only／alias／override）。
  matchBasis String?                @map("match_basis")

  settlementBrokerId String? @map("settlement_broker_id") // 雞頭碼→brokers；冇雞頭碼欄嘅盤=null（Phase B 由系統設定補）
  settlementBroker   Broker? @relation(fields: [settlementBrokerId], references: [id])

  hours    Decimal? @db.Decimal(5, 2) // OT 小時（OT<n> 代號）
  warnings Json? // 逐行警告（例：未配對、code 對唔到、日期唔喺目標月份）

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([uploadId, workDate])
  // Phase B-1（§14.1／§15.3 分期，B1-8 第 4 項）：對數引擎逐更配對鍵要查
  // 「呢個上載呢個月呢個（子）盤」嘅 rows——冇呢個 index 就要 seq scan
  // 成張 roster_upload_rows。
  @@index([resolvedSiteId])
  @@map("roster_upload_rows")
}

// ---------------------------------------------------------------------------
// WP-GUARD-FIX-UI（老闆 2026-09-25 要求）：「未配對安員修復」做入系統，
// 俾老闆手機撳兩下就搞掂（唔使再喺 Terminal 貼 DB 連線字串）。同
// `roster_uploads` 一致嘅「即時存 bytes＋摘要，唔另存逐行 PII」模式——
// U Team 名單逐次上載都要喺 plan 計算嗰刻由 bytes 重新解析（記憶體，
// 唔落 DB），`staff_list_uploads` 本身淨係存檔案＋數目，冧唔到姓名/
// 電話/身份證。PII 級——`安員配對修復` module 老闆硬性專用（見
// src/lib/rbac/matrix.ts），主管/會計/雞頭/安員一律 403（會批量建人、
// 睇身份證）。
model StaffListUpload {
  id           String                @id @default(uuid())
  uploaderId   String                @map("uploader_id")
  uploader     User                  @relation(fields: [uploaderId], references: [id])
  uploadedAt   DateTime              @default(now()) @map("uploaded_at")
  fileName     String                @map("file_name")
  fileSha256   String                @map("file_sha256")
  fileBytes    Bytes                 @map("file_bytes")
  fileSize     Int                   @map("file_size")
  rowCount     Int                   @map("row_count")
  status       StaffListUploadStatus @default(parsed)
  // {row_count, u_number_count, hkid_valid_count, hkid_invalid_count,
  // parse_error} 呢類數目——唔存逐行姓名/電話/身份證（鐵則）。
  parseSummary Json?                 @map("parse_summary")

  createdAt DateTime @default(now()) @map("created_at")

  guardFixRuns GuardFixRun[]

  // 最新一份（`uploadedAt` 最大、`status=parsed`）為現用——查詢用
  // `orderBy: {uploadedAt: "desc"}` 取第一筆，冇另外用 boolean 旗標（避免
  // 兩個 "current" 同時存在嘅競態）。
  @@index([status, uploadedAt])
  @@map("staff_list_uploads")
}

enum StaffListUploadStatus {
  parsed
  parse_failed
}

// ---------------------------------------------------------------------------
// WP-LTSHIFT §19（老闆 2026-09-26 第二部分）：Postorder（`Postorder - Aug
// 2026.xlsm` 呢類總表）上載——同 `staff_list_uploads` 一模一樣嘅「即時存
// bytes＋摘要，唔另存逐行 PII」模式：guard-fix `plan`/`apply` 嗰刻先由
// `fileBytes` 重新解析（記憶體，唔落 DB）。`parseSummary` 淨係數目（盤
// 數／格數／介紹費行數），唔存逐行人名——人名淨係喺 plan 計算果一刻喺
// 記憀體度用嚟 matchGuard，唔會落 DB 呢張表。
// `month`：呢份 Postorder 對應邊個月（file 名/內容通常淨係一個月），
// 用嚟揀「呢個月而家生效嗰份」（同 staff_list_uploads 一致：`orderBy
// uploadedAt desc` 揀第一筆 `status=parsed`，唔用 boolean 旗標）。
// ---------------------------------------------------------------------------
model PostorderUpload {
  id                    String                @id @default(uuid())
  month                 DateTime              @db.Date // 月份第一日
  uploaderId            String                @map("uploader_id")
  uploader              User                  @relation(fields: [uploaderId], references: [id])
  uploadedAt            DateTime              @default(now()) @map("uploaded_at")
  fileName              String                @map("file_name")
  fileSha256            String                @map("file_sha256")
  fileBytes             Bytes                 @map("file_bytes")
  fileSize              Int                   @map("file_size")
  rowCount              Int                   @map("row_count")
  status                PostorderUploadStatus @default(parsed)
  // {longterm_post_count, longterm_site_count, referral_row_count,
  // referral_broker_labels_unresolved_count, parse_error} 呢類數目——
  // 唔存逐行姓名（鐵則）。
  parseSummary          Json?                 @map("parse_summary")
  // WP-POSTORDER-CSV（老闆 2026-09-26 緊急）：正式站操作員工具處理唔到
  // binary（.xlsm／.xlsx），淨係可以攞到 Google Sheets 匯出嘅 CSV——
  // 呢兩欄存原始 CSV bytes（Roster／PostOrder 分頁各一份），nullable，
  // 有值＝呢份係 CSV 上載（`fileBytes`／`fileName`／`fileSha256`／
  // `fileSize` 呢陣淨係佔位／audit 用途，唔係真正解析嘅資料源——見
  // `src/lib/guard-fix/postorder.ts` `parsePostorderUploadRow()`）。
  rosterCsvBytes        Bytes?                @map("roster_csv_bytes")
  postorderCsvBytes     Bytes?                @map("postorder_csv_bytes")
  // WP-POSTORDER-PAIRS-CSV（老闆 2026-09-27 緊急）：正式站操作員連
  // Google Sheets 匯出完整 Roster 分頁都持續 503——加呢欄存極精簡嘅
  // 「(盤,人) 組合＋格數」CSV（`site_label,site_short,guard_name,
  // cell_count`，見 `scripts/guard-fix/export-postorder-pairs.ts`／
  // `src/lib/guard-fix/postorder.ts` `parseLongtermPairsCsv()`），有值
  // 就優先用（跌返 `rosterCsvBytes`／`fileBytes` 見
  // `parsePostorderUploadRow()`）。
  longtermPairsCsvBytes Bytes?                @map("longterm_pairs_csv_bytes")

  createdAt DateTime @default(now()) @map("created_at")

  guardFixRuns GuardFixRun[]

  @@index([month, status, uploadedAt])
  @@map("postorder_uploads")
}

enum PostorderUploadStatus {
  parsed
  parse_failed
}

// 一次「計劃／套用」執行——`plan_json` 帶 PII（姓名/電話/身份證/候選
// guardId），只有老闆可讀（field-level gate 由 route 層 `安員配對修復`
// 硬性單一角色保證，唔需要額外 field-group——呢個資源成塊都係老闆專
// 用）。`summary_json` 淨係數目，方便歷史列表唔使反覆解 `plan_json`。
model GuardFixRun {
  id                String           @id @default(uuid())
  month             DateTime         @db.Date
  staffListUploadId String           @map("staff_list_upload_id")
  staffListUpload   StaffListUpload  @relation(fields: [staffListUploadId], references: [id])
  // WP-LTSHIFT §19：呢個 run 計劃嗰陣有冇用到 Postorder 上載（set_longterm/
  // set_longterm_post/set_referral/set_visa 四類計劃嘅來源）——nullable，
  // 冇上載 Postorder 都照舊計到 link/create 嗰幾類。
  postorderUploadId String?          @map("postorder_upload_id")
  postorderUpload   PostorderUpload? @relation(fields: [postorderUploadId], references: [id])
  createdById       String           @map("created_by_id")
  createdBy         User             @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now()) @map("created_at")

  planJson    Json @map("plan_json")
  summaryJson Json @map("summary_json")

  status         GuardFixRunStatus @default(planned)
  appliedAt      DateTime?         @map("applied_at")
  // Opus 5.5 驗收：幾時開始套用——`applying` 超過 15 分鐘當卡死（server
  // 中途重啟），頁面俾老闆「重新套用」（見 runs/[id]/apply/route.ts）。
  applyStartedAt DateTime?         @map("apply_started_at")
  // apply 完成之後嘅結果：逐盤 reparse 前後 unmatched/ambiguous 數＋
  // link/create/create_minimal 處理/跳過數（冇 PII，純數目＋seq）。
  resultJson     Json?             @map("result_json")

  @@index([month, createdAt])
  @@map("guard_fix_runs")
}

enum GuardFixRunStatus {
  planned
  // WP-GUARD-FIX-UI：apply 可能要幾分鐘（建人＋逐盤 reparse）——route
  // 用 Next `after()` 響應先返、背景先做，呢個中途狀態俾頁面 poll
  // `GET /api/guard-fix/runs/:id` 用（見 §18.9 設計取捨）。
  applying
  applied
  failed
}

// ---------------------------------------------------------------------------
// guard_match_overrides（驗收 Opus 5.5，2026-09-26）：更表「工號衝突」保守
// 預設——更表某行寫嘅工號屬 DB 另一位安員（姓名對唔上，B1-8「唔准配」），
// 老闆指令唔可以留「要老闆決定」：guard-fix 按更表姓名建一個獨立安員
// （cash_casual、無工號），再喺度記低「呢個（正規化）工號＋呢個更表姓名
// → 嗰個獨立安員」，`matchGuard()` 見到完全相同組合先會配（唔影響其他
// 工號／姓名組合，B1-8 原則照舊）。`reason` 寫「工號衝突待核」等 HR 之後
// 覆核；作廢唔刪（voided_at）。
// ---------------------------------------------------------------------------
model GuardMatchOverride {
  id        String    @id @default(uuid())
  staffNo   String    @map("staff_no") // 正規化工號（normalizeStaffNumber）
  nameRaw   String    @map("name_raw") // 更表姓名原文（trim）
  guardId   String    @map("guard_id")
  guard     Guard     @relation(fields: [guardId], references: [id], onDelete: Restrict)
  reason    String
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  @@unique([staffNo, nameRaw])
  @@index([guardId])
  @@map("guard_match_overrides")
}

// ---------------------------------------------------------------------------
// WP-LTSHIFT §19 交付 C：「重新對數全月」一次執行——同 `guard_fix_runs`
// 一致嘅背景工作／卡死復原設計（見 apply.ts GUARD_FIX_ADVISORY_LOCK_KEY／
// view.ts APPLY_STALE_MS 嘅同款 pattern，呢度用另一個 advisory lock
// key，見 src/lib/roster-upload/reconcile-all.ts）。`result_json` 逐盤
// 前後 roster_only／settlement_diff／unresolved／寫入／改結算單位數，
// 純數目＋盤名，冇 PII。
// ---------------------------------------------------------------------------
model ReconcileAllRun {
  id           String                @id @default(uuid())
  month        DateTime              @db.Date
  status       ReconcileAllRunStatus @default(running)
  startedAt    DateTime              @default(now()) @map("started_at")
  startedById  String                @map("started_by_id")
  startedBy    User                  @relation(fields: [startedById], references: [id])
  finishedAt   DateTime?             @map("finished_at")
  resultJson   Json?                 @map("result_json")
  errorMessage String?               @map("error_message")

  @@index([month, startedAt])
  @@map("reconcile_all_runs")
}

enum ReconcileAllRunStatus {
  running
  done
  failed
}

// ---------------------------------------------------------------------------
// WP-ROSTER-UPLOAD Phase B-1（§14.1 WP-ATTRIB／§15.3 分期）：對數頁「保留
// 系統」／「例外」呢兩種決定——唔改 shift_records，但要留痕（邊個、幾
// 時、原因），等會計之後可以追溯「呢個差異係咪已經有人睇過、點解冇跟更
// 表改」。`apply_roster` 決定唔喺呢度留一行——嗰種決定本身已經反映喺
// shift_records 嘅 create/update/void audit_log（`writeAudit()`），呢度
// 淨係記「唔跟更表」嗰兩種、要解釋原因嘅決定，避免同 audit_log 重複存
// 一份幾乎一樣嘅嘢。
//
// `reconcileKey` 唔用 DB FK（對唔上 `shift_records` 嘅 `roster_only`／
// `unresolved` 分類、或者未配對嘅 upload row 都可能有決定）——用
// `buildReconcileKey()`（`src/lib/roster-upload/reconcile.ts`）砌出嚟嘅
// 穩定字串（work_date|site_id|guard_id|shift_type_id，或者
// `row:<roster_upload_row_id>` 呢類冇齊配對鍵嘅情況）。
// ---------------------------------------------------------------------------
model RosterReconcileDecision {
  id       String       @id @default(uuid())
  uploadId String       @map("upload_id")
  upload   RosterUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  reconcileKey String  @map("reconcile_key")
  category     String // 決定嗰刻嘅分類（roster_only/system_only/guard_diff/settlement_diff/shift_type_diff/unresolved），純記錄用途
  action       String // 'keep_system' | 'exception'（apply_roster 唔存喺呢度，見上面大註解）
  reason       String?

  decidedBy String   @map("decided_by")
  decidedAt DateTime @default(now()) @map("decided_at")

  @@unique([uploadId, reconcileKey])
  @@index([uploadId])
  @@map("roster_reconcile_decisions")
}

