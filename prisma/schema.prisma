// ---------------------------------------------------------------------------
// WP-ONE-CLICK Phase 1（老闆 2026-09-26「一鍵全月結算」，§20）：單一伺服器
// 端 job，串連現有 lib（guard-fix／roster-upload reconcile／longterm-
// settlement／reports）由上載更表到出報告，可重跑、冪等、每步檢查點。
//
// `status` 刻意淨係 3 個值（同 `ReconcileAllRunStatus`／`GuardFixRunStatus`
// 一致嘅碼庫慣例）——任務書寫嘅「stalled」係*顯示層*概念（`applying`
// 超過 15 分鐘當卡死，見 `src/lib/month-close/one-click.ts`
// `monthCloseRunStalled()`），唔係 DB 實際會寫入嘅狀態（一個真正卡死嘅
// process 冇機會自己將狀態改做「stalled」）——同 guard-fix/reconcile-all
// 兩個現成 job 表嘅設計一致，唔另起爐灶。
model MonthCloseRun {
  id             String              @id @default(uuid())
  month          DateTime            @db.Date // 月份第一日
  status         MonthCloseRunStatus @default(running)
  startedById    String              @map("started_by_id")
  startedBy      User                @relation(fields: [startedById], references: [id])
  startedAt      DateTime            @default(now()) @map("started_at")
  finishedAt     DateTime?           @map("finished_at")
  // 呢次「認領」（開始執行背景工作）嘅時間——用嚟判斷卡死（超過 15
  // 分鐘未完成）。每次「重新執行」都會更新呢個值（唔改 startedAt，
  // 保留第一次撳「一鍵結算」嘅時間）。
  applyStartedAt DateTime?           @map("apply_started_at")
  // 而家行緊邊一步（step key，例：precheck/parse_health/guard_fix/…），
  // 頁面用嚟顯示進度；完成或者失敗都保留最後一步嘅 key。
  currentStep    String?             @map("current_step")
  // 逐步紀錄陣列：{key,label,status,started_at,finished_at,numbers,
  // warnings[],needs_human[]}——每步完成即刻寫返 DB，頁面 poll 見到即時
  // 進度，唔使等成個 job 完先有嘢睇。
  stepsJson      Json                @default("[]") @map("steps_json")
  // step6-8 埋單報告：總收入/成本/毛利、逐雞頭應付、逐盤收入、介紹費、
  // 對照差額（如有）、未定價清單、needs_human 匯總、鎖月前置結果。
  reportJson     Json?               @map("report_json")
  errorMessage   String?             @map("error_message")

  @@index([month, startedAt])
  @@map("month_close_runs")
}

enum MonthCloseRunStatus {
  running
  done
  failed
}

// ---------------------------------------------------------------------------
// RBAC：users / roles / permissions / role_permissions
// ---------------------------------------------------------------------------
model Role {
  id                  String   @id @default(uuid())
  name                String   @unique
  payoutApprovalLimit Decimal? @map("payout_approval_limit") @db.Decimal(12, 2)
  // 「角色可複製再改」——true = 由某個預設角色複製出嚟嘅自訂角色；五個出廠
  // 角色（老闆/主管/會計/雞頭/安員）呢欄係 false，唔可以被 void。
  isCustom            Boolean  @default(false) @map("is_custom")
  // P1-WP2 Opus 驗收殘留2：自訂角色嘅硬性 deny 矩陣來源——複製自邊個出廠
  // 角色，創建之後唔可以改（冇對應 update API），isHardDenied() 用呢個
  // 而唔係 name 判斷（防止改名逃過硬性禁止）。五個出廠角色呢欄 = 自己個
  // name（"老闆"/"主管"/…）。
  baseRole            String   @map("base_role")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String           @id @default(uuid())
  module String // 更表／配額／審批／價目／盤／安員／雞頭／糧務／報表／系統
  action PermissionAction

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  granted      Boolean    @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String          @id @default(uuid())
  triageSessionsOwned TriageSession[] @relation("TriageSessionOwner")
  name                String
  tel                 String          @unique // 登入用
  passwordHash        String          @map("password_hash")
  roleId              String          @map("role_id")
  role                Role            @relation(fields: [roleId], references: [id])
  guardId             String?         @map("guard_id") // 安員登入
  guard               Guard?          @relation(fields: [guardId], references: [id])
  brokerId            String?         @map("broker_id") // 雞頭登入
  broker              Broker?         @relation(fields: [brokerId], references: [id])
  payoutApprovalLimit Decimal?        @map("payout_approval_limit") @db.Decimal(12, 2) // 覆蓋角色預設上限
  allowedIp           String?         @map("allowed_ip") // 登入 IP 限制（預留，WP2 唔實作 enforcement）
  status              UserStatus      @default(active)

  // 登入鎖定（WP2 §A）
  lastLoginAt    DateTime? @map("last_login_at")
  lastLoginIp    String?   @map("last_login_ip")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  mustChangePwd  Boolean   @default(false) @map("must_change_pwd")
  // P1-WP2 Opus 驗收殘留1：session 作廢——每次 issue 一個 session 都寫入
  // 當時嘅 token_version；requireSession() 每次都同 DB 現值核對，唔啱就
  // 當 session 已失效。logout／改密碼／改角色／改 broker／void user 全部
  // 要 bump（見 src/lib/auth/token-version.ts）。
  tokenVersion   Int       @default(1) @map("token_version")

  // SMS OTP——欄位預留，WP2 唔實作發送/驗證邏輯
  otpEnabled DateTime? @map("otp_enabled") // null = 未啟用；非 null = 啟用時間（預留）
  otpSecret  String?   @map("otp_secret") // 預留，WP2 唔寫入

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  auditLogs        AuditLog[]
  aiConversation   AiConversation?
  // P2.5：現場反映開會模式——一個用戶同時最多一個 draft（見
  // src/lib/feedback/session.ts 嘅 getOrCreateDraftSession()），但歷史
  // 上可以有幾個 submitted/abandoned，所以係 array 唔係 unique 一對一。
  feedbackSessions FeedbackSession[]
  rosterUploads    RosterUpload[]
  feedbackReports  FeedbackReport[]
  // WP-GUARD-FIX-UI：邊個上載咗 U Team 名單／邊個叫過「計劃／套用」。
  staffListUploads StaffListUpload[]
  guardFixRuns     GuardFixRun[]
  // WP-LTSHIFT §19：邊個上載咗 Postorder 總表。
  postorderUploads PostorderUpload[]
  reconcileAllRuns ReconcileAllRun[]
  // WP-ONE-CLICK：邊個撳過「一鍵結算」。
  monthCloseRuns   MonthCloseRun[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// audit_log 操作紀錄（只寫入，DB trigger 拒絕 UPDATE/DELETE）
