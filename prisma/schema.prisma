// ---------------------------------------------------------------------------
// RBAC：users / roles / permissions / role_permissions
// ---------------------------------------------------------------------------
model Role {
  id                  String   @id @default(uuid())
  name                String   @unique
  payoutApprovalLimit Decimal? @map("payout_approval_limit") @db.Decimal(12, 2)
  // 「角色可複製再改」——true = 由某個預設角色複製出嚟嘅自訂角色；五個出廠
  // 角色（老闆/主管/會計/雞頭/安員）呢欄係 false，唔可以被 void。
  isCustom            Boolean  @default(false) @map("is_custom")
  // P1-WP2 Opus 驗收殘留2：自訂角色嘅硬性 deny 矩陣來源——複製自邊個出廠
  // 角色，創建之後唔可以改（冇對應 update API），isHardDenied() 用呢個
  // 而唔係 name 判斷（防止改名逃過硬性禁止）。五個出廠角色呢欄 = 自己個
  // name（"老闆"/"主管"/…）。
  baseRole            String   @map("base_role")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  voidedAt  DateTime? @map("voided_at")
  voidedBy  String?   @map("voided_by")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String           @id @default(uuid())
  module String // 更表／配額／審批／價目／盤／安員／雞頭／糧務／報表／系統
  action PermissionAction

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id])
  granted      Boolean    @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                  String     @id @default(uuid())
  name                String
  tel                 String     @unique // 登入用
  passwordHash        String     @map("password_hash")
  roleId              String     @map("role_id")
  role                Role       @relation(fields: [roleId], references: [id])
  guardId             String?    @map("guard_id") // 安員登入
  guard               Guard?     @relation(fields: [guardId], references: [id])
  brokerId            String?    @map("broker_id") // 雞頭登入
  broker              Broker?    @relation(fields: [brokerId], references: [id])
  payoutApprovalLimit Decimal?   @map("payout_approval_limit") @db.Decimal(12, 2) // 覆蓋角色預設上限
  allowedIp           String?    @map("allowed_ip") // 登入 IP 限制（預留，WP2 唔實作 enforcement）
  status              UserStatus @default(active)

  // 登入鎖定（WP2 §A）
  lastLoginAt    DateTime? @map("last_login_at")
  lastLoginIp    String?   @map("last_login_ip")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  mustChangePwd  Boolean   @default(false) @map("must_change_pwd")
  // P1-WP2 Opus 驗收殘留1：session 作廢——每次 issue 一個 session 都寫入
  // 當時嘅 token_version；requireSession() 每次都同 DB 現值核對，唔啱就
  // 當 session 已失效。logout／改密碼／改角色／改 broker／void user 全部
  // 要 bump（見 src/lib/auth/token-version.ts）。
  tokenVersion   Int       @default(1) @map("token_version")

  // SMS OTP——欄位預留，WP2 唔實作發送/驗證邏輯
  otpEnabled DateTime? @map("otp_enabled") // null = 未啟用；非 null = 啟用時間（預留）
  otpSecret  String?   @map("otp_secret") // 預留，WP2 唔寫入

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  auditLogs      AuditLog[]
  aiConversation AiConversation?
  // P2.5：現場反映開會模式——一個用戶同時最多一個 draft（見
  // src/lib/feedback/session.ts 嘅 getOrCreateDraftSession()），但歷史
  // 上可以有幾個 submitted/abandoned，所以係 array 唔係 unique 一對一。
  feedbackSessions FeedbackSession[]
  feedbackReports  FeedbackReport[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// audit_log 操作紀錄（只寫入，DB trigger 拒絕 UPDATE/DELETE）
// ---------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  actor       User?    @relation(fields: [actorUserId], references: [id])
  tableName   String   @map("table_name")
  rowId       String   @map("row_id")
  action      String // create/update/void/login/login_failed/logout/lock/unlock…
  before      Json?
  after       Json?
  ip          String? // WP2：邊個IP做嘅（設計文件§3.2 audit_log「邊個、幾時、邊張表邊行、改前JSON、改後JSON」+ P1計劃登入IP記入audit）
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tableName, rowId])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// payout_batches / expenses — P3 先實作，呢度淨係預留表名（stub）
// ---------------------------------------------------------------------------
model PayoutBatch {
  id       String            @id @default(uuid())
  month    DateTime          @db.Date
  brokerId String?           @map("broker_id")
  status   PayoutBatchStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@map("payout_batches")
}

model Expense {
  id       String   @id @default(uuid())
  month    DateTime @db.Date
  siteId   String?  @map("site_id")
  category String?
  amount   Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@map("expenses")
}

// ---------------------------------------------------------------------------
// ai_conversations（WP-AI1）：側欄 AI 助手嘅對話記錄——唯讀助手本身淨係
// 讀 `ai.*` schema（見 prisma/migrations/…_wp_ai1_readonly_schema），呢個
// 表反而係一般讀寫（用主 Prisma client），純粹存「呢個 user 同助手嘅
// 對話 history」，唔屬於「AI 可以查嘅業務數據」，所以擺喺呢度用返一般
// migration 流程（唔使加入 ai schema）。
// user_id unique——每個 user 得一條對話記錄（設計裁定：唔留多個分頁
// session，簡化「清空自己嘅對話」語意）。
// ---------------------------------------------------------------------------
model AiConversation {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  messages  Json     @default("[]") // 最多保留 30 turn（見 src/lib/ai/conversation.ts）
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_conversations")
}

// ---------------------------------------------------------------------------
// P2.5「現場反映」開會模式（老闆 2026-09-15 拍板，方案 D）——助手做訪談員
// （src/lib/ai/feedback-prompt.ts），唔評可行性（見 feasibility-guard.ts），
// 討論存 feedback_sessions；撳「整理並送出」由伺服器叫模型按範本生成
// 摘要，用戶預覽可改，確認先由伺服器 code（唔係模型工具）寫入
// feedback_reports。`ai` schema 唔加呢兩張表嘅 view（模型讀唔到原始
// session），老闆讀意見用 `list_feedback` 呢個獨立工具（
// src/lib/feedback/ai-tools/list-feedback.ts，唔經 zoikan_ai_ro，因為
// 唔喺 ai schema——見 docs/ai-assistant.md「開會反映」一節嘅例外說明）。
// ---------------------------------------------------------------------------
model FeedbackSession {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])
  // draft|submitted|abandoned——一個用戶同時最多一個 draft（application
  // 層保證，見 getOrCreateDraftSession()，冇加 DB partial unique index，
  // 同呢個 codebase 其他「一個時點限一個」規則一致做法，例如
  // ai_conversations 用 unique(userId) 就唔使呢招，但呢度要保留歷史
  // submitted/abandoned session，唔可以做 unique(userId)）。
  status      String   @default("draft")
  messages    Json     @default("[]") // 格式同 ai_conversations.messages 一致：{role,content,createdAt}[]
  pageContext Json?    @map("page_context") // {path,site_id,month,broker}——同 AiPageContext 一致，純提示用途

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reports FeedbackReport[]

  @@index([userId, status])
  @@map("feedback_sessions")
}

model FeedbackReport {
  id        String          @id @default(uuid())
  sessionId String          @map("session_id")
  session   FeedbackSession @relation(fields: [sessionId], references: [id])
  userId    String          @map("user_id")
  user      User            @relation(fields: [userId], references: [id])
  roleName  String          @map("role_name") // 快照——提出人嗰陣嘅角色名，唔跟返 user.role 之後嘅改動

  title     String
  summaryMd String @map("summary_md") // 完整範本文字，用戶確認版（伺服器由 fields 組成，唔靠模型排版）
  fields    Json // {title,reporter,current_problem,desired_change,reason,related,open_questions,footer}

  transcriptExcerpt Json @map("transcript_excerpt") // 最後 20 輪對話節錄

  // new|read|forwarded|declined
  status     String    @default("new")
  reviewNote String?   @map("review_note")
  reviewedBy String?   @map("reviewed_by") // 老闆 user id（plain string，同呢個 codebase voidedBy 一致做法，唔起 FK relation）
  reviewedAt DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([userId])
  @@map("feedback_reports")
}
